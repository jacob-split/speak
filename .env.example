# Provider session preconnect lifetime for direct and Personal Phone calls.
VOICE_SESSION_PRECONNECT_TTL_MS=15000

# Playground Browser/Phone start cancellation tombstones. Keep this longer
# than every provider/readiness request so a delayed start cannot outlive a
# tab-close, reset, or navigation cancellation.
PLAYGROUND_START_REQUEST_TTL_MS=900000
PLAYGROUND_START_REQUEST_MAX_ENTRIES=2048

# Playground Phone audio Whisper transcription. The key stays server-side.
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_LANGUAGE=en-US
PLAYGROUND_AUDIO_WHISPER_MAX_MS=30000

